# Dependencias
node_modules/

# Secretos y estado local del bot
bot/.env
bot/.wwebjs_auth/
bot/.wwebjs_cache/
bot/data/

# Cloudflare / wrangler
.dev.vars
.wrangler/

# Temporales
tmp-*.mjs
*.log
logs/

# Imágenes intermedias del catálogo (se regeneran con
# scripts/catalogo/optimizar-imagenes.py; el PDF final sí se versiona)
docs/catalogo/img-opt/
docs/catalogo/catalogo.html

# Imágenes cosechadas de la web (intermedias, se regeneran con
# scripts/catalogo/fase1-candidatos.js y fase2-validar.py)
docs/catalogo/_imagenes-nuevas/

# Sistema
.DS_Store
Thumbs.db

docs/catalogo/_respaldo-originales/

docs/catalogo/catalogo-editado.pdf
# no subir archivos con secretos generados para el servidor
deploy/pterodactyl/bot.env.produccion*
deploy/pterodactyl/bot.env.produccion2
deploy/pterodactyl/bot.env.produccion3
deploy/pterodactyl/servidor-payload*.json
deploy/pterodactyl/*.env
deploy/pterodactyl/*.env.*
!deploy/pterodactyl/*.example
!deploy/pterodactyl/*.env.production.example

# temporales de diagnostico
bot/.tmp-*
docs/auditoria/capturas/responsive/

# imagenes generadas del catalogo
docs/catalogo/preview-*.png

# respaldos locales del bot
backups/

# Higiene del repo (auditoría de secretos, 2026-11-11): respaldos y archivos
# de operación del servidor no se versionan; la clave pública de Coolify tampoco.
*.bak.html
*.bak
deploy/backup-http/
deploy/coolify-public-key.txt

# Capturas de pantalla del panel/Coolify: pueden mostrar nombres y teléfonos de
# clientes. Las capturas que YA están versionadas se revisan a mano antes de
# decidir si se retiran del índice (git rm --cached).
docs/auditoria/capturas/*.png
