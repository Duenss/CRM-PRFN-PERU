# ============================================================
# Perfumería Fina · Bot de WhatsApp — PRODUCCIÓN
# Copia este archivo como bot/.env y completa los valores reales.
# NUNCA subas bot/.env al repositorio.
# ============================================================

# --- Supabase (obligatorio) ---
SUPABASE_URL=https://pcesvmsewfpvmqmfmswn.supabase.co
# Project Settings > API > service_role (solo en el servidor, jamás en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
PORT=3000
# Una sesión por número de WhatsApp. Con un solo número de tienda: 1
SESIONES=1
# Número del dueño para avisos (formato 51910418951)
OWNER_NUMBER=
# Protege el panel del bot y la API. Genera uno largo:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOT_TOKEN=

# --- IA ---
# Recomendado en producción: Gemini API con facturación (la suscripción
# Gemini Pro/Advanced NO incluye cuota de API).
GEMINI_API_KEY=
# Respaldo gratuito (console.groq.com → API Keys): texto y transcripción de audios.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# AI_MODEL=gemini-3.6-flash

# --- Seguridad de envíos ---
# false = envía de verdad. Ponlo true solo para pruebas.
MODO_PRUEBA=false
# Números permitidos cuando MODO_PRUEBA=true (vacío en producción).
NUMEROS_PRUEBA=
# Endpoint de simulación de mensajes entrantes (déjalo en false en producción).
SIMULAR_ENTRANTES=false

# --- Automatización ---
AUTO_RESPUESTA=true
RESPONDER_DESCONOCIDOS=true

# --- Fotos, pedidos y seguimiento ---
PANEL_URL=https://perfumeriafinaperu.com
SEGUIMIENTO_DIAS_1=3
SEGUIMIENTO_DIAS_2=180
# Cupos por hora para recojo en estación (evita varios pedidos a la misma hora).
CUPOS_ESTACION=2

# --- Ritmo de envío (segundos entre mensajes) ---
DELAY_MIN=25
DELAY_MAX=40
# Límite de mensajes por día (protege tu número de WhatsApp)
MAX_POR_DIA=80

# --- Horario de atención (hora de Lima) ---
HORA_INICIO=9
HORA_FIN=20
LUNES_A_SABADO=true

# --- Datos de pago (el administrador verifica el pago digital) ---
PAGO_YAPE_NUMERO=
PAGO_YAPE_TITULAR=
PAGO_PLIN_NUMERO=
PAGO_PLIN_TITULAR=
PAGO_TRANSFERENCIA_NUMERO=
PAGO_TRANSFERENCIA_TITULAR=

# --- Chromium / sesión ---
# En Docker se usa /usr/bin/chromium. En VPS con Chrome propio, ruta completa.
CHROME_PATH=
# true = sin ventana (obligatorio en servidor; el QR se escanea desde el panel).
HEADLESS=true
# Carpeta de la sesión de WhatsApp. Respáldala: si se borra, hay que escanear el QR.
SESSION_PATH=.wwebjs_auth