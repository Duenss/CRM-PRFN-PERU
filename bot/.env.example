# ============================================================
# Bot de WhatsApp - Perfumeria Fina Peru
# Copia este archivo como .env y completa los valores.
# ============================================================

# --- Supabase (obligatorio) ---
SUPABASE_URL=https://pcesvmsewfpvmqmfmswn.supabase.co
# Project Settings > API > service_role (NUNCA la pongas en el navegador)
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
PORT=3000
# Dos sesiones = dos numeros de WhatsApp. Puedes dejar solo "1".
SESIONES=1,2
# Numero del dueno para avisos (formato 51910418951)
OWNER_NUMBER=51910418951
# Token opcional para proteger el panel del bot. Si lo pones,
# el panel lo pedira y el CRM lo enviara en la cabecera.
BOT_TOKEN=

# --- IA (elige una) ---
GEMINI_API_KEY=
# Respaldo gratuito (opcional): console.groq.com -> API Keys. Sirve para texto y audios.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_AUDIO_MODEL=whisper-large-v3-turbo
# ANTHROPIC_API_KEY=
# AI_MODEL=gemini-3.6-flash

# --- Seguridad de envios ---
# true = no envia nada real; solo muestra en el registro. Empieza asi.
MODO_PRUEBA=true
# Numeros permitidos en modo prueba (separados por coma, con 51)
NUMEROS_PRUEBA=

# Automatizacion
AUTO_RESPUESTA=true
RESPONDER_DESCONOCIDOS=true

# Fotos de producto, pedidos y seguimiento post-venta
# URL publica con las fotos (web de la tienda o panel en Cloudflare Pages)
PANEL_URL=https://perfumeriafinaperu.com
SEGUIMIENTO_DIAS_1=3
SEGUIMIENTO_DIAS_2=180

# Ritmo de envio (segundos entre clientes)
DELAY_MIN=25
DELAY_MAX=40
# Limite de mensajes por dia (0 = sin limite; se respeta el intervalo)
MAX_POR_DIA=0

# Horario de atencion (hora de Lima)
HORA_INICIO=9
HORA_FIN=20
LUNES_A_SABADO=true

# --- Datos de pago (billeteras digitales: el administrador verifica el pago) ---
# Sin plantillas: solo números/titular por variable de entorno.
PAGO_YAPE_NUMERO=
PAGO_YAPE_TITULAR=
PAGO_PLIN_NUMERO=
PAGO_PLIN_TITULAR=
PAGO_TRANSFERENCIA_NUMERO=
PAGO_TRANSFERENCIA_TITULAR=
# Cupos por hora para recojo en estación (evita 5 pedidos a la misma hora).
CUPOS_ESTACION=2

# --- Chromium / sesion ---
# Vacio = usa el Chrome de pruebas de Puppeteer (npx puppeteer browsers install chrome).
# Si falla, pon la ruta completa a chrome.exe.
CHROME_PATH=
# true = sin ventana de Chrome (recomendado/producción; el QR se ve en el panel).
# false = abre una ventana de Chrome con WhatsApp Web (solo para depurar).
HEADLESS=true
# Carpeta donde se guarda la sesion (no la borres o tendras que escanear el QR otra vez)
SESSION_PATH=.wwebjs_auth