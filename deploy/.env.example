# Copia este archivo como .env en el servidor (o pega estas variables en
# Coolify → Environment Variables). NO lo subas al repositorio.

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Bot
BOT_TOKEN=
SESIONES=1
OWNER_NUMBER=
OWNER_EMAIL=
NUMEROS_PRUEBA=
MODO_PRUEBA=false
SIMULAR_ENTRANTES=false
AUTO_RESPUESTA=true
RESPONDER_DESCONOCIDOS=true

# IA (opcional)
GEMINI_API_KEY=
AI_MODEL=

# Ritmo de envío / horario (hora Lima)
DELAY_MIN=25
DELAY_MAX=40
MAX_POR_DIA=0
HORA_INICIO=9
HORA_FIN=20
LUNES_A_SABADO=true
SEGUIMIENTO_DIAS_1=3
SEGUIMIENTO_DIAS_2=10

# Panel
PANEL_URL=https://crm.perfumeriafinaperu.com
PANEL_ORIGINS=https://crm.perfumeriafinaperu.com,https://crm-prfn-peru.pages.dev
PANEL_USER=dueno
PANEL_PASS=
