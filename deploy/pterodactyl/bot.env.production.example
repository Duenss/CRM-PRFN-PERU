# ============================================================
# Perfumería Fina · Bot de WhatsApp — PLANTILLA de producción
# Copia este archivo como bot/.env en el servidor y completa los
# valores reales. NUNCA subas el .env con claves al repositorio.
# ============================================================

# --- Supabase (obligatorio) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Project Settings > API Keys > secret key (solo en el servidor)
SUPABASE_SERVICE_ROLE_KEY=

# --- Servidor ---
PORT=25577
# Token largo y aleatorio para la API del bot (el panel lo usa a través del proxy)
BOT_TOKEN=

# --- Modo ---
MODO_PRUEBA=false
SIMULAR_ENTRANTES=false
NUMEROS_PRUEBA=

# --- WhatsApp ---
HEADLESS=true
AUTO_RESPUESTA=true
RESPONDER_DESCONOCIDOS=true

# --- Ritmo de envío ---
# 0 = sin límite diario (solo se respeta el intervalo entre mensajes)
MAX_POR_DIA=0
DELAY_MIN=25
DELAY_MAX=40
HORA_INICIO=9
HORA_FIN=20

# --- IA ---
GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Panel / CORS ---
# Origen del panel desplegado (Cloudflare Pages) y del panel local.
PANEL_ORIGIN=https://TU-PANEL.pages.dev
PANEL_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Seguridad extra (opcional) ---
# Usuario y clave para entrar a /panel y /qr directamente al bot.
PANEL_USER=
PANEL_PASS=
